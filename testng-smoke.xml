<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Smoke Suite">

    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>

    <!-- runs only the tests marked with groups = "smoke" -->
    <test name="Smoke Tests">
        <groups>
            <run><include name="smoke"/></run>
        </groups>
        <packages>
            <package name="tests"/>
        </packages>
    </test>

</suite>
